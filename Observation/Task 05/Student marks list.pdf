<div class="uml-methods">~ Student(rollNo: int, name: String, marks: int[])<br>~ calculateTotal() : int<br>~ calculateAverage() : double<br>~ highestMarks() : int<br>~ lowestMarks() : int<br>~ calculatePercentage() : double<br>~ getGrade() : String<br>~ getRemark() : String<br>~ displayReport() : void</div>
</div>
