~ animalFood : String<br>
~ animalSound : String
</div>
<div class="uml-methods">
~ FarmAnimal(animalName: String, animalPlace: String, animalFood: String, animalSound: String)<br>
~ showDetails() : void
</div>
</div>

<div class="connector-area">▲<br>: (creates &amp; uses instances)<br>:</div>

<div class="uml-box" style="margin-top:0;">
<div class="uml-class-header">FarmAnimalDemo</div>
<div class="uml-methods">+ main(args : String[]) : void {static}</div>
</div>

<p style="margin-top:14px;"><strong>Relationship:</strong> <code>FarmAnimalDemo</code> instantiates objects (<code>cow</code>, <code>pig</code>, <code>horse</code>) and invokes the <code>showDetails()</code> method of the <code>FarmAnimal</code> class.</p>

<h2 class="section-header">Source Code:</h2>
<div class="code-block">class FarmAnimal {
    String animalName;
    String animalPlace;
    String animalFood;
    String animalSound;

    // Constructor to initialize animal details
    FarmAnimal(String animalName, String animalPlace, String animalFood, String animalSound) {
        this.animalName = animalName;
        this.animalPlace = animalPlace;
        this.animalFood = animalFood;
        this.animalSound = animalSound;
    }

    // Method to display animal details
    void showDetails() {
        System.out.println("Animal Name : " + animalName);
        System.out.println("Lives At    : " + animalPlace);
        System.out.println("Food        : " + animalFood);
        System.out.println("Sound       : " + animalSound);
        System.out.println();
    }
}

public class FarmAnimalDemo {
    public static void main(String[] args) {
        // Creating animal instances
        FarmAnimal cow = new FarmAnimal("Cow", "Cowshed", "Grass", "Moo");
        FarmAnimal pig = new FarmAnimal("Pig", "Pigsty", "Vegetables", "Oink");
        FarmAnimal horse = new FarmAnimal("Horse", "Stable", "Grass", "Neigh");

        // Displaying details of each animal
        cow.showDetails();
        pig.showDetails();
        horse.showDetails();
    }
}</div>

<h2 class="section-header">Compilation &amp; Execution Commands:</h2>
<div class="meta-field"><span class="meta-label">Save file as:</span> FarmAnimalDemo.java</div>
<div class="meta-field"><span class="meta-label">Compilation:</span> javac FarmAnimalDemo.java</div>
<div class="meta-field"><span class="meta-label">Execution:</span> java FarmAnimalDemo</div>

