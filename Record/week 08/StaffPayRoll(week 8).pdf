<p style="margin-top:14px;"><strong>Relationship:</strong> <code>PermanentStaff</code> and <code>TemporaryStaff</code> extend the base class <code>Staff</code>. The driver class <code>StaffPayroll</code> instantiates and invokes them dynamically via superclass references.</p>

<h2 class="section-header">Source Code:</h2>
<div class="code-block">// Parent class
class Staff {
    String staffId;

    Staff(String staffId) {
        this.staffId = staffId;
    }

    void calculateSalary() {
        System.out.println("Employee Salary Information:");
    }
}

class PermanentStaff extends Staff {
    PermanentStaff(String staffId) {
        super(staffId);
    }

    @Override
    void calculateSalary() {
        int basic = 28000;
        int allowance = 12000;
        int travel = 4000;

        int grossSalary = basic + allowance + travel;

        System.out.println("Salary Information:");
        System.out.println("Basic Salary : " + basic);
        System.out.println("Allowance    : " + allowance);
        System.out.println("Travel Allow.: " + travel);
        System.out.println("Gross Salary : " + grossSalary);
    }
}

class TemporaryStaff extends Staff {
    TemporaryStaff(String staffId) {
        super(staffId);
    }

    @Override
    void calculateSalary() {
        int basic = 15000;
        int allowance = 2000;
        int travel = 2500;

        int grossSalary = basic + allowance + travel;

        System.out.println("Salary Information:");
        System.out.println("Basic Salary : " + basic);
        System.out.println("Allowance    : " + allowance);
        System.out.println("Travel Allow.: " + travel);
        System.out.println("Gross Salary : " + grossSalary);
    }
}

public class StaffPayroll {
    public static void main(String args[]) {
        String staffId = "P101";

        if (staffId.startsWith("P")) {
            Staff worker = new PermanentStaff(staffId);
            worker.calculateSalary();
        } else if (staffId.startsWith("T")) {
            Staff worker = new TemporaryStaff(staffId);
            worker.calculateSalary();
        } else {
            System.out.println("Invalid Staff ID");
        }
    }
}</div>

<h2 class="section-header">Compilation &amp; Execution Commands:</h2>
<div class="meta-field"><span class="meta-label">Save file as:</span> StaffPayroll.java</div>
<div class="meta-field"><span class="meta-label">Compilation:</span> javac StaffPayroll.java</div>
<div class="meta-field"><span class="meta-label">Execution:</span> java StaffPayroll</div>

